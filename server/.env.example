# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env
DATABASE_URL="mysql://root:@localhost:3307/hostay_db"

# Chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

PORT=4000

# Thư mục chứa ảnh phòng (dùng chung với bản PHP trong giai đoạn chuyển đổi)
UPLOAD_DIR="../public/images"
