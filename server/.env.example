# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env
DATABASE_URL="mysql://root:MAT_KHAU@localhost:3306/hostay_db"

# Chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

PORT=4000

# Thư mục chứa ảnh phòng (tương đối với thư mục server/)
UPLOAD_DIR="uploads"

# Kết nối MySQL qua SSL (bắt buộc với MySQL trên cloud như Aiven). Để trống khi dùng MySQL trên máy.
# Nhận đường dẫn tới file CA (vd: "ca.pem") hoặc dán thẳng nội dung "-----BEGIN CERTIFICATE-----..."
DB_SSL_CA=""

# Production: "production" bật cookie Secure và tin reverse proxy (Render). Để trống khi phát triển.
# NODE_ENV="production"

# Thư mục bản build React mà server phục vụ (mặc định ../client/dist)
# CLIENT_DIST="../client/dist"

# Gửi email trả lời liên hệ (để trống nếu chưa cấu hình; chức năng trả lời sẽ báo lỗi)
# Với Gmail: dùng "Mật khẩu ứng dụng", không dùng mật khẩu đăng nhập
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Hostay"
